const slug = "sigil-2-8-image-editing-epub-guide-2026";
const title = "Sigil 2.8.0: New Image Editing Features & EPUB Editing Guide (2026)";
const description = "Sigil 2.8.0 adds image rotate, crop, and resize directly in the editor. Complete guide to editing EPUB files with the latest release and its new ImageTab.";
const pubDate = "2026-06-23";
---

<Layout title={title} description={description} canonicalUrl={`https://converter-epub.com/blog/${slug}/`} ogType="article" datePublished={pubDate}>
  <main class="blog-post">
    <article itemscope itemtype="https://schema.org/Article">
      <meta itemprop="headline" content={title} />
      <meta itemprop="description" content={description} />
      <meta itemprop="datePublished" content="2026-06-23" />
