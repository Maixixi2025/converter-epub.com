---
import Layout from '../../layouts/Layout.astro';

const slug = "calibre-edit-epub-metadata-2026";
const title = "How to Edit EPUB Metadata with Calibre: Complete Guide 2026";
const description = "Master EPUB metadata editing with Calibre. Fix incorrect titles, authors, and covers. Add series info, tags, descriptions. Complete step-by-step guide for Windows, Mac, and Linux.";
const pubDate = "2026-07-13";
---

<Layout title={title} description={description} canonicalUrl={`https://converter-epub.com/blog/${slug}/`} ogType="article" datePublished={pubDate}>
  <main class="blog-post">
    <article itemscope itemtype="https://schema.org/Article">
      <meta itemprop="headline" content={title} />
      <meta itemprop="description" content={description} />
